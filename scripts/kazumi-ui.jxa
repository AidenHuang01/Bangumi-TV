// Fixed official-app-scoped Accessibility driver. Inputs are data, not code.
// Only the verified 2.4.2 portrait layout is automated. No keys or databases.
function run(argv) {
  const input = JSON.parse(argv[0] || '{}');
  const events = Application('System Events');
  const proc = events.applicationProcesses.whose({ bundleIdentifier: 'com.example.kazumi' })[0];
  if (!proc.exists() || proc.windows.length !== 1) throw new Error('Kazumi must have exactly one window');
  const win = proc.windows[0];
  function get(fn, fallback) { try { return fn(); } catch (_) { return fallback; } }
  if (input.action === 'prepare') {
    const originalSize = win.size();
    // Never toggle AX off: that previously crashed this Flutter build.
    proc.attributes.byName('AXEnhancedUserInterface').value = true;
    win.size = [640, 860]; proc.frontmost = true;
    return JSON.stringify({ originalSize: originalSize });
  }
  if (input.action === 'restore-window') {
    if (!Array.isArray(input.size) || input.size.length !== 2 || input.size.some(v => !Number.isInteger(v) || v < 300 || v > 5000))
      throw new Error('Invalid original window size');
    win.size = input.size; return JSON.stringify({ ok: true });
  }
  const elements = win.entireContents();
  const rows = elements.slice(0, 1000).map((element, index) => ({ index: index,
    role: get(() => element.role(), ''),
    label: get(() => element.description(), '') || get(() => element.name(), '') || '',
    enabled: get(() => element.enabled(), true)
  }));
  if (input.action === 'snapshot') return JSON.stringify({ title: win.name(), rows: rows });
  if (input.action === 'player-state') return JSON.stringify({ ready: get(() => proc.menuBars[0].menuBarItems.byName('Player').enabled(), false) });
  function portrait() {
    const size = win.size();
    if (size[0] !== 640 || size[1] !== 860) throw new Error('Kazumi layout changed; clicks stopped');
    proc.frontmost = true;
    if (!proc.frontmost()) throw new Error('Kazumi is not frontmost');
  }
  function clickPoint(point) {
    portrait();
    if (point[0] < 0 || point[0] >= 640 || point[1] < 0 || point[1] >= 860)
      throw new Error('Control is outside the Kazumi window');
    ObjC.import('CoreGraphics');
    const pos = win.position(), xy = { x: pos[0] + point[0], y: pos[1] + point[1] };
    function post(type) { $.CGEventPost(0, $.CGEventCreateMouseEvent(null, type, xy, 0)); }
    post(1); delay(0.05); post(2); delay(0.15);
  }
  if (input.action === 'home-search') {
    portrait();
    if (!rows.some(row => row.label.indexOf('第 1 个标签，共 4 个') >= 0) || rows.some(row => row.role === 'AXTextField'))
      throw new Error('Not the Kazumi home page');
    const buttons = rows.filter(row => row.role === 'AXButton' && !row.label);
    if (buttons.length !== 4) throw new Error('Kazumi home toolbar changed');
    events.click(elements[buttons[0].index]);
    return JSON.stringify({ ok: true });
  }
  if (input.action === 'search-text') {
    portrait();
    const fields = rows.filter(row => row.role === 'AXTextField');
    if (fields.length !== 1 || !rows.some(row => row.label === '番剧搜索') || typeof input.text !== 'string' || !input.text || input.text.length > 200)
      throw new Error('Not a unique Kazumi search field');
    const field = elements[fields[0].index], pos = field.position(), size = field.size(), origin = win.position();
    clickPoint([pos[0] - origin[0] + size[0] / 2, pos[1] - origin[1] + size[1] / 2]);
    // Pasting supports Chinese/Japanese; preserve every clipboard type locally.
    // Clipboard content is never logged, returned or transmitted.
    ObjC.import('AppKit');
    const board = $.NSPasteboard.generalPasteboard, saved = [];
    const items = board.pasteboardItems;
    for (let i = 0; i < items.count; i++) {
      const item = items.objectAtIndex(i), copy = $.NSPasteboardItem.alloc.init;
      for (let j = 0; j < item.types.count; j++) {
        const type = item.types.objectAtIndex(j), data = item.dataForType(type);
        if (data) copy.setDataForType(data, type);
      }
      saved.push(copy);
    }
    try {
      board.clearContents; board.setStringForType($(input.text), $.NSPasteboardTypeString);
      events.keystroke('a', { using: 'command down' }); events.keystroke('v', { using: 'command down' });
      delay(0.2); events.keyCode(36);
    } finally { board.clearContents; if (saved.length) board.writeObjects($(saved)); }
    return JSON.stringify({ ok: true });
  }
  if (input.action === 'download-sheet') {
    portrait();
    const menu = proc.menuBars[0].menuBarItems.byName('Player');
    if (!menu.enabled())
      throw new Error('Not the portrait episode panel');
    const labelled = rows.filter(row => row.label === '缓存剧集');
    if (labelled.length === 1) events.click(elements[labelled[0].index]);
    else clickPoint([612, 570]); // Verified 640×860 toolbar, outside video.
    return JSON.stringify({ ok: true });
  }
  if (input.action !== 'press' || typeof input.label !== 'string' || !input.label || input.label.length > 300)
    throw new Error('Unsupported Kazumi UI action');
  let scoped = rows;
  if (input.provider) {
    const start = rows.findIndex(row => row.label.indexOf('来源规则：' + input.provider + '，') === 0);
    if (start < 0) throw new Error('Provider is not visible');
    const next = rows.findIndex((row, index) => index > start && row.label.indexOf('来源规则：') === 0);
    scoped = rows.slice(start + 1, next < 0 ? undefined : next);
  }
  const matches = scoped.filter(row => row.label === input.label && (!input.role || row.role === input.role));
  if (matches.length !== 1 || !matches[0].enabled) throw new Error('Kazumi control is missing, ambiguous or disabled');
  // Flutter image/text tiles often expose no AXPress. Click the freshly
  // resolved element's bounds rather than assuming AX click activated it.
  const target = elements[matches[0].index], pos = target.position(), size = target.size(), origin = win.position();
  if (!size[0] || !size[1]) throw new Error('Kazumi control has no visible bounds');
  clickPoint([pos[0] - origin[0] + size[0] / 2, pos[1] - origin[1] + size[1] / 2]);
  return JSON.stringify({ ok: true });
}
